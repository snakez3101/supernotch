<!--
  SuperNotch Info.plist template (owner: FOUNDATION, see docs/SPEC.md B.1 and G.3).
  Scripts/package_app.sh copies this file into SuperNotch.app/Contents/ and fills in the version keys:
    CFBundleShortVersionString  numeric part of the version (1.2.3)
    CFBundleVersion             build number
    SNFullVersion               full version string (1.2.3-rc.1, 0.0.0-ci.42)
    SNGitCommit                 short git commit hash
  The values below are placeholders for a plain `swift build` run; never ship them.
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>SuperNotch</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.snakez3101.supernotch</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>SuperNotch</string>
    <key>CFBundleDisplayName</key>
    <string>SuperNotch</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0</string>
    <key>SNFullVersion</key>
    <string>0.0.0-dev</string>
    <key>SNGitCommit</key>
    <string>unknown</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
